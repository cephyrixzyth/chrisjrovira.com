{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "virtual-chris-guide",
  "main": "index.js",
  "compatibility_date": "2026-10-03",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [{ "name": "BUDGET", "class_name": "DailyBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DailyBudget"] }]
}
